# Copy to settings.toml — never commit real credentials.

# WiFi (ESP32 joins your LAN)
CIRCUITPY_WIFI_SSID = ""
CIRCUITPY_WIFI_PASSWORD = ""

# Web terminal password (browser login at http://<esp32-ip>/)
WEB_PASSWORD = "change-me"

# CircuitPython Web Workflow (poetry run deploy over WiFi) — always port 80
CIRCUITPY_WEB_API_PASSWORD = ""
# CIRCUITPY_WEB_API_PORT = 80

# Optional: printed in docs only — set after boot from serial REPL output
ESP32_IP = ""

# HTTP port for the web terminal (80 is used by CircuitPython Web Workflow)
WEB_PORT = 8080

# UART to Raspberry Pi console (GPIO14/15 on the Pi header)
PI_UART_BAUD = 115200
# Show a startup line in the web terminal (proves HTTP path; set 0 to disable)
# UART_BANNER = 1
